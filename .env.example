# ==========================================
# DEFAULT TIMEZONE
# ==========================================

DEFAULT_TIMEZONE=Asia/Kolkata


# ==========================================
# OUTPUT FORMATS
# ==========================================

DEFAULT_DATE_FORMAT=%Y-%m-%d
DEFAULT_TIME_FORMAT=%H:%M:%S


# ==========================================
# CALENDAR CONFIGURATION
# ==========================================

# Monday = 0
# Tuesday = 1
# Wednesday = 2
# Thursday = 3
# Friday = 4
# Saturday = 5
# Sunday = 6

WEEK_STARTS_ON=0


# ==========================================
# OPERATION LIMITS
# ==========================================

MAX_DATE_RANGE_DAYS=366
MAX_LIST_DAYS=366

# Maximum number of days/weeks/months/years
# in a relative calendar date operation.

MAX_RELATIVE_DATE_AMOUNT=10000

# Maximum elapsed duration for relative datetime operations.
# 315360000 seconds = 10 years.

MAX_RELATIVE_DATETIME_SECONDS=315360000